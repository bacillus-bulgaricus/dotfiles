#!/usr/bin/env bash
set -euo pipefail

ssh_dir="$HOME/.ssh"
config_file="$ssh_dir/config"
managed_include='Include ~/.ssh/config_chezmoi'
begin_marker='## BEGIN -- chezmoi'
end_marker='## END -- chezmoi'

mkdir -p "$ssh_dir"
touch "$config_file"
chmod 700 "$ssh_dir"
chmod 600 "$config_file"

if ! awk -v begin="$begin_marker" -v end="$end_marker" '
  $0 == begin {
    if (in_block || seen_block) invalid=1
    in_block=1
    seen_block=1
    next
  }
  $0 == end {
    if (!in_block) invalid=1
    in_block=0
    next
  }
  END { exit(invalid || in_block ? 1 : 0) }
' "$config_file"; then
  echo "Refusing to update $config_file: unbalanced chezmoi markers" >&2
  exit 1
fi

tmp_file="$(mktemp "$ssh_dir/.config.chezmoi.XXXXXX")"
trap 'rm -f "$tmp_file"' EXIT

awk -v begin="$begin_marker" -v end="$end_marker" '
  $0 == begin {in_block=1; next}
  $0 == end {in_block=0; next}
  !in_block {print}
' "$config_file" > "$tmp_file"

if [[ -s "$tmp_file" ]]; then
  printf '\n' >> "$tmp_file"
fi
printf '%s\n%s\n%s\n' "$begin_marker" "$managed_include" "$end_marker" >> "$tmp_file"

chmod 600 "$tmp_file"
mv -f "$tmp_file" "$config_file"
trap - EXIT
